{
  "name": "game2048-backend",
  "version": "1.0.0",
  "description": "2048 棋盘合并与撤销回放后端（TypeScript + Node.js + SQLite，仅 API 与 CLI）",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "game2048": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "demo": "tsx src/demo.ts",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
